# 复制为 .env 并修改；.env 勿提交到仓库
# 部署时 DB_USER/DB_PASSWORD/DB_NAME 同时用于 Postgres 容器与应用连接，需一致

# 服务配置
APP_NAME=space
APP_ENV=production
APP_PORT=8000
APP_DEBUG=true

# 数据库（Postgres 容器与 app 共用，部署时务必修改 DB_PASSWORD）
DB_HOST=localhost
DB_PORT=5432
DB_USER=space
DB_PASSWORD=space_dev
DB_NAME=space
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=space-service
KAFKA_TOPIC_TX_REQUEST=nft.tx.request
KAFKA_TOPIC_TX_SUCCESS=nft.tx.success
KAFKA_TOPIC_TX_FAILED=nft.tx.failed

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# IPFS
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8081

# 链服务
CHAIN_SERVICE_URL=http://star:8090


STAR_APP_NAME=star
STAR_APP_ENV=production
STAR_APP_LOG_LEVEL=info

# 数据库
STAR_DATABASE_HOST=postgres
STAR_DATABASE_PORT=5432
STAR_DATABASE_USER=star
STAR_DATABASE_PASSWORD=star_password
STAR_DATABASE_DBNAME=star

# Kafka
STAR_KAFKA_BROKERS=kafka:29092
STAR_KAFKA_GROUP_ID=star-service

# 区块链（RPC 模式）
STAR_BLOCKCHAIN_MODE=index
STAR_BLOCKCHAIN_INDEX_API_BASE_URL=https://api.tbcdev.org
STAR_BLOCKCHAIN_RPC_URL=https://192.168.1.12:8000
STAR_BLOCKCHAIN_RPC_USER=test
STAR_BLOCKCHAIN_RPC_PASSWORD=test

# ZMQ
STAR_ZMQ_ENDPOINT=tcp://192.168.1.12:28332

# HTTP
STAR_HTTP_ENABLED=true
STAR_HTTP_PORT=8081
